{
  LinearLayout;
  orientation="vertical";
  layout_width="fill";
  padding="12dp";
  {
    TextView;
    id="title";
    layout_width="fill";
    textSize="13dp";
    textColor=0xFF1C2B3A;
  };
  {
    TextView;
    id="subtitle";
    layout_width="fill";
    textSize="10dp";
    textColor=0xFF5F6F7C;
    singleLine=true;
  };
};
