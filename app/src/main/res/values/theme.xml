<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Platform.V21.Theme.MiniLuaXPLUS.Material3" parent="Theme.Material3.DynamicColors.DayNight">
        <item name="colorPrimaryDark">@color/system_window_scrim_compat</item>
    </style>
    <style name="Platform.Theme.MiniLuaXPLUS.Material3" parent="Platform.V21.Theme.MiniLuaXPLUS.Material3" />

    <style name="Base.Theme.MiniLuaXPLUS.Material3" parent="Platform.Theme.MiniLuaXPLUS.Material3">
        <item name="colorAccent">?colorPrimary</item>
        <item name="actionBarStyle">@style/Widget.MiniLuaXPLUS.Material3.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.MiniLuaXPLUS.Material3.ActionBar</item>
        <item name="actionModeStyle">@style/Widget.MiniLuaXPLUS.Material3.ActionMode</item>
        <item name="textInputStyle">?textInputOutlinedDenseStyle</item>
        <!-- 防止溢出菜单串色 -->
        <item name="actionBarPopupTheme">@null</item>
    </style>
    <style name="Theme.MiniLuaXPLUS.Material3" parent="Base.Theme.MiniLuaXPLUS.Material3" />

    <!-- 编辑器固定浅色主题：不跟随系统深色，避免代码区与弹窗反复串色。 -->
    <style name="Theme.MiniLuaXPLUS.EditorLight" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/editor_light_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSurface">@color/editor_light_surface</item>
        <item name="colorOnSurface">@color/editor_light_on_surface</item>
        <item name="android:windowBackground">@color/editor_light_background</item>
        <item name="android:statusBarColor">@color/editor_light_surface</item>
        <item name="android:navigationBarColor">@color/editor_light_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Base.Theme.MiniLuaXPLUS.Material3.Welcome" parent="Theme.MiniLuaXPLUS.Material3" />
    <style name="Theme.MiniLuaXPLUS.Material3.Welcome" parent="Base.Theme.MiniLuaXPLUS.Material3.Welcome"/>


    <style name="AppTheme.Material3" parent="Theme.MiniLuaXPLUS.Material3"/>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorAccent">?colorPrimary</item>
        <item name="colorPrimaryDark">?colorPrimary</item>
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorSurface">@color/color_surface</item>
    </style>

    <style name="AppWelcome" parent="Theme.MiniLuaXPLUS.Material3.Welcome"/>
</resources>